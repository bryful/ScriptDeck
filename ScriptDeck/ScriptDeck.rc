#include "ResourceIds.h"
#include <winver.h>
// Keep application icon first, Deck icon second (DefaultIcon indices 0 and 1).
IDI_SCRIPTDECK_APP ICON "assets/scriptdeck.ico"
IDI_SCRIPTDECK_DECK ICON "assets/deck.ico"
IDR_SCRIPTDECK_LOGO RCDATA "assets/logo.png"
IDR_SCRIPTDECK_HOME RCDATA "assets/home.deck"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "bryful\0"
   VALUE "FileDescription", "ScriptDeck\0"
   VALUE "FileVersion", "1.0.0\0"
   VALUE "InternalName", "ScriptDeck\0"
   VALUE "OriginalFilename", "ScriptDeck.exe\0"
   VALUE "ProductName", "ScriptDeck\0"
   VALUE "ProductVersion", "1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
