          "name": "Update",
          "resourceId": "",
          "script": "function mouseUp(event) {\n    this.card.objectByName(\"message\").text = \"Test\";\n    const list = this.card.objectById(\"list\");\n    list.selectedIndex = (list.selectedIndex + 1) % list.itemCount;\n    this.card.objectByName(\"dropdown\").selectedIndex = list.selectedIndex;\n    this.text = \"選択: \" + list.selectedText;\n}",
