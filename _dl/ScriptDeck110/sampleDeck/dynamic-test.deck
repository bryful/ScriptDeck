{
  "cards": [
    {
      "backgroundColor": [
        0.9300000071525574,
        0.9599999785423279,
        1.0,
        1.0
      ],
      "enterButtonId": "add",
      "escapeButtonId": "",
      "id": "card1",
      "name": "Dynamic Objects",
      "objects": [
        {
          "enabled": true,
          "height": 32,
          "id": "status",
          "imagePath": "",
          "imageSource": "file",
          "items": [],
          "name": "status",
          "resourceId": "",
          "script": "",
          "selectedIndex": -1,
          "text": "動的オブジェクト数: 0",
          "type": "text",
          "visible": true,
          "width": 600,
          "x": 20,
          "y": 20,
          "checked": false,
          "group": ""
        },
        {
          "enabled": true,
          "height": 32,
          "id": "add",
          "imagePath": "",
          "imageSource": "file",
          "items": [],
          "name": "Add",
          "resourceId": "",
          "script": "function mouseUp() {\n    const n = ++createdCount;\n    const row = (n - 1) % 3;\n    const list = this.card.createObject(\"listbox\", {\n        name: \"dyn_list_\" + n, x: 20, y: 120 + row * 110, width: 280, height: 90,\n        items: [\"項目 \" + n, \"赤\", \"緑\", \"青\"], selectedIndex: 0\n    });\n    this.card.createObject(\"button\", {\n        name: \"dyn_delete_\" + n, text: \"この組を削除\", x: 340, y: 120 + row * 110, width: 200, height: 40,\n        script: \"function mouseUp() { this.card.removeObject(\" + JSON.stringify(list.id) + \"); this.remove(); updateStatus(); }\"\n    });\n    updateStatus();\n}",
          "selectedIndex": -1,
          "text": "作成",
          "type": "button",
          "visible": true,
          "width": 180,
          "x": 20,
          "y": 65,
          "checked": false,
          "group": ""
        },
        {
          "enabled": true,
          "height": 32,
          "id": "clone",
          "imagePath": "",
          "imageSource": "file",
          "items": [],
          "name": "Clone",
          "resourceId": "",
          "script": "function mouseUp() {\n    const lists = this.card.objects.filter(o => o.type === \"listbox\");\n    if (lists.length) lists[lists.length - 1].clone({name:\"dyn_copy_\" + (++createdCount), x:340, y:200, width:260});\n    updateStatus();\n}",
          "selectedIndex": -1,
          "text": "最後のリストを複製",
          "type": "button",
          "visible": true,
          "width": 180,
          "x": 220,
          "y": 65,
          "checked": false,
          "group": ""
        },
        {
          "enabled": true,
          "height": 32,
          "id": "clear",
          "imagePath": "",
          "imageSource": "file",
          "items": [],
          "name": "Clear",
          "resourceId": "",
          "script": "function mouseUp() {\n    for (const object of this.card.objects) if (object.name.startsWith(\"dyn_\")) object.remove();\n    updateStatus();\n}",
          "selectedIndex": -1,
          "text": "動的部品を全削除",
          "type": "button",
          "visible": true,
          "width": 180,
          "x": 420,
          "y": 65,
          "checked": false,
          "group": ""
        }
      ],
      "script": ""
    }
  ],
  "currentCardId": "card1",
  "format": "ScriptDeck",
  "height": 480,
  "name": "Dynamic Object Test",
  "script": "var createdCount = 0;\nfunction updateStatus() {\n    app.currentCard.objectById(\"status\").text = \"動的オブジェクト数: \" + (app.currentCard.objectCount - 4);\n}",
  "startupPlacement": "default",
  "version": 1,
  "width": 640
}
