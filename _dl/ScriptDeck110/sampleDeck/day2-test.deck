      "script": "function openCard() {\n    this.objectByName(\"message\").text = \"ファイルをカードへドロップするか、開くボタンを押してください。\";\n}\nfunction dropFiles(event) {\n    const list = this.objectByName(\"files\");\n    list.items = event.paths;\n    list.selectedIndex = event.paths.length ? 0 : -1;\n    this.objectByName(\"message\").text = \"ドロップ: \" + event.paths.length + \"件 (\" + event.x + \", \" + event.y + \")\";\n}"
    }
