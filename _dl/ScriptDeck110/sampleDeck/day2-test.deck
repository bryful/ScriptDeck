          "id": "save",
          "imagePath": "",
          "imageSource": "file",
          "items": [],
          "name": "save",
          "resourceId": "",
          "script": "function mouseUp() {\n    const json = this.card.objectByName(\"asJson\").checked;\n    const path = app.saveFileDialog({title:\"パス一覧を保存\",defaultName:json?\"paths.json\":\"paths.txt\",defaultExtension:json?\"json\":\"txt\",\n        filters:[{name:\"一覧\",pattern:json?\"*.json\":\"*.txt\"},{name:\"すべて\",pattern:\"*.*\"}]});\n    if (path !== null) {\n        const items = this.card.objectByName(\"files\").items;\n        fs.writeText(path,json?JSON.stringify(items,null,2):items.join(\"\\r\\n\"),this.card.objectByName(\"bom\").checked);\n        this.card.objectByName(\"message\").text = \"保存先: \" + path;\n    }\n}",
          "selectedIndex": -1,
