          "name": "open",
          "resourceId": "",
          "script": "function mouseUp() {\n    const files = app.openFileDialog({title:\"ファイルを開く\", multiple:true, filters:[{name:\"すべてのファイル\",pattern:\"*.*\"}]});\n    if (files !== null) {\n        this.card.objectByName(\"files\").items = files;\n        this.card.objectByName(\"files\").selectedIndex = files.length ? 0 : -1;\n        this.card.objectByName(\"message\").text = \"選択: \" + files.length + \"件\";\n    } else this.card.objectByName(\"message\").text = \"選択をキャンセルしました。\";\n}",
          "selectedIndex": -1,
          "text": "ファイルを開く（複数）",
          "type": "button",
          "visible": true,
          "width": 280,
          "x": 20,
